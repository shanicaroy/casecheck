{
  "name": "case-check",
  "version": "0.2.0",
  "private": true,
  "description": "Portfolio review agent: finds the weakest part of a UX case study's narrative. See docs/ and the product contract.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fetch": "tsx src/cli/fetch.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "next": "16.3.4",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "22.x"
  }
}
